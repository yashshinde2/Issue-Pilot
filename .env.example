# Issue Pilot Environment Configuration
# Copy this file to .env and provide your actual values.
# NEVER commit credentials to version control.

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=issue_pilot
# MongoDB Pool & Timeout Settings (Optional)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=10000

# GitHub API Configuration
# Optional personal access token (recommended for higher rate limits: 5000 requests/hr vs 60/hr)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_API_BASE_URL=https://api.github.com

# Ingestion & Candidate Pool Policy
INGESTION_ENABLED=true
CANDIDATE_POOL_TARGET=3000
RECENT_WINDOW_DAYS=30
OLDER_WINDOW_DAYS=90
DISCOVERY_CADENCE_HOURS=24
REFRESH_CADENCE_DAYS=3
MAX_ISSUES_PER_REPO=15
MAX_SEARCH_PAGES_PER_RUN=5
PER_PAGE_COUNT=30

# GitHub Rate Limit & Resiliency Settings
GITHUB_RATE_LIMIT_BUFFER=10
GITHUB_REQUEST_TIMEOUT_SECONDS=15
GITHUB_MAX_RETRIES=3

# Background Scheduler Policy
SCHEDULER_ENABLED=false

# Recommendation & Verification
FINAL_RECOMMENDATION_COUNT=5
VERIFICATION_CANDIDATE_LIMIT=30

# C++ Ranking Engine Executable Path
CPP_ENGINE_PATH=ranking_engine/build/issue_pilot_ranking_engine.exe

# Security & CORS (comma-separated origins or *)
CORS_ORIGINS=*
